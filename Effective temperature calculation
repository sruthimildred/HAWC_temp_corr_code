
#Pressure levels
import numpy as np
p = np.array([650, 600, 550, 500, 450, 400, 350, 300,250, 200, 150, 100, 70, 50, 40, 30,
20, 10, 7])
# Computes differences between pressure levels
delta p = np.gradient(p)
#Lambda value
lambda = 120
#Compute exponential weighted factor
weights = np.exp(-p / lambda) * delta p
#Compute summation of weights * delta p
summation result = np.sum(weights)
# Print results
print("Weights:", weights)
print("Summation of (weights * delta p):", summation result)
